# Application Settings
APP_NAME=FanZone Israeli Sports Ingestion Backend
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (Default: local SQLite with async driver, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./fan_zone.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/fanzone
DB_ECHO=false

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_SECONDS=2.0
USE_MOCK_AI=false

# Scheduler & Scraper Settings
ENABLE_SCHEDULER=true
POLL_INTERVAL_SECONDS=300
SCRAPER_TIMEOUT_SECONDS=15
MAX_CONCURRENT_SCRAPES=4
